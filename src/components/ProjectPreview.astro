---
interface ProjectProps {
    title: string;
    description: string;
    thumbnail: string;
    tags: string[];
    sourceCode: string;
}
const { title, description, thumbnail, tags, sourceCode } =
    Astro.props as ProjectProps;
---

<article
    class="w-full max-w-[22rem] flex flex-col rounded-md overflow-hidden shadow-xl shadow-black/60 bg-bgrd-b"
>
    <img
        class="h-48 w-full object-cover"
        src={thumbnail}
        alt={`${title} thumbnail`}
        width={352}
        height={192}
    />
    <div class="flex justify-center flex-wrap gap-3 px-4 py-2 border-b-2 border-gray">
        {tags.map((tech) => <h5 class="text-sm">{tech}</h5>)}
    </div>
    <div class="flex flex-col gap-4 p-5 flex-1">
        <h2 class="text-2xl">{title}</h2>
        <p class="text-gray flex-1">{description}</p>
        <a
            class="text-white flex items-center justify-center gap-2 border-accent border-2 h-12 px-4 cursor-pointer font-bold self-start"
            href={sourceCode}
        >
            <img src="/Github.svg" alt="" width={20} height={20} />
            Source Code
        </a>
    </div>
</article>
