---
interface ProjectProps {
    title: string;
    description: string;
    thumbnail: string;
    tags: string[];
    sourceCode?: string;
    liveUrl?: string;
    reportUrl?: string;
}
const { title, description, thumbnail, tags, sourceCode, liveUrl, reportUrl } =
    Astro.props as ProjectProps;
---

<article
    class="snap-center shrink-0 w-[22rem] flex flex-col rounded-md overflow-hidden shadow-xl shadow-black/60 bg-bgrd-b"
>
    <img
        class="h-48 w-full object-cover"
        src={thumbnail}
        alt={`${title} thumbnail`}
        width={352}
        height={192}
    />
    <div class="flex justify-center flex-wrap gap-3 px-4 py-2 border-b-2 border-gray">
        {tags.map((tech) => <h5 class="text-sm">{tech}</h5>)}
    </div>
    <div class="flex flex-col gap-4 p-5 flex-1">
        <h2 class="text-2xl">{title}</h2>
        <p class="text-gray flex-1">{description}</p>
        <div class="flex flex-wrap gap-3">
            {liveUrl && (
                <a
                    class="text-white flex items-center justify-center gap-2 bg-accent border-accent border-2 h-12 px-4 cursor-pointer font-bold"
                    href={liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Live Site
                </a>
            )}
            {sourceCode && (
                <a
                    class="text-white flex items-center justify-center gap-2 border-accent border-2 h-12 px-4 cursor-pointer font-bold"
                    href={sourceCode}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img src="/Github.svg" alt="" width={20} height={20} />
                    Source Code
                </a>
            )}
            {reportUrl && (
                <a
                    class="text-white flex items-center justify-center gap-2 border-accent border-2 h-12 px-4 cursor-pointer font-bold"
                    href={reportUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Analytics Report
                </a>
            )}
        </div>
    </div>
</article>
