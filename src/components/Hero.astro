---

<section
    id="hero"
    class="relative flex w-full min-h-[40rem] flex-wrap gap-8 justify-evenly p-4 md:p-[2rem] overflow-y-auto"
>
    <div
        class="hidden md:absolute top-0 left-[2rem] w-[3rem] h-fit md:flex flex-col items-center basis-1/6"
    >
        <div class="h-[14rem] w-[1px] border-l-2 border-gray"></div>
        <a href="https://www.linkedin.com/in/dan-ngendahayo-6956b1193/">
            <img
                src="/Linkedin.svg"
                alt="LinkdedIn link"
                width={30}
                height={30}
            />
        </a>
        <a href="https://github.com/Dan925">
            <img
                src="/Github.svg"
                alt="GitHub link"
                width={30}
                height={30}
            />
        </a>
    </div>
    <div
        class="w-full md:basis-1/3 flex flex-col px-2 md:px-[7rem] gap-8 md:gap-[5rem]"
    >
        <span>
            <h1 class="text-4xl md:text-6xl">
                Dan <span class="text-accent">Ngendahayo</span>
            </h1>
            <h2 class="text-gray text-xl md:text-3xl mt-2">
                Full stack engineer turning ideas into shipped products.
            </h2>
        </span>
        <span class="flex flex-wrap gap-3">
            <a
                href="#contacts"
                class="bg-bgrd text-gray hover:text-white border-2 w-[10rem] h-[3rem] p-[.2rem] font-bold cursor-pointer flex items-center justify-center"
                >Contact me !!</a
            >
            <a
                href="/resume"
                class="bg-accent text-white w-[10rem] h-[3rem] p-[.2rem] font-bold cursor-pointer flex items-center justify-center"
                >Resume</a
            >
        </span>
    </div>
    <div
        class="w-full md:basis-1/3 flex flex-col items-center gap-6"
    >
        <div
            class="relative w-full max-w-[24rem] md:w-[34rem] h-[20rem] md:h-[32rem]"
        >
            <img
                class="w-[16rem] md:w-[29rem] z-0 absolute top-0 left-4 opacity-30"
                src="/prof.svg"
                alt="Hero Image"
                width={464}
                height={490}
            />
            <img
                class="absolute bottom-14 right-2 z-10"
                src="/lines.svg"
                alt="prof-lines"
                width={100}
                height={100}
            />
            <img
                class="absolute top-2 left-0 z-10"
                src="/dots.svg"
                alt="prof-dots"
                width={100}
                height={100}
            />
        </div>
        <div class="flex items-center gap-4 px-2 z-0">
            <div class="bg-accent w-[15px] h-[15px] shrink-0"></div>
            <p class="text-sm md:text-base">
                Software engineering graduate from uOttawa with 4+ years of full
                stack experience
            </p>
        </div>
    </div>
</section>
