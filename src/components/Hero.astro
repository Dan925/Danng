---
---

<section
    id="hero"
    class="pt-24 md:pt-[120px] pb-16 md:pb-20 px-4 md:px-8 max-w-[900px] mx-auto"
>
    <div
        class="text-xs text-[var(--fg)] opacity-50 mb-6 tracking-[0.04em]"
    >
        <span class="text-[var(--accent)]">dan@portfolio</span><span
            class="opacity-50">:</span
        ><span class="text-[#61afef]">~</span><span class="opacity-50">
            $ whoami</span
        >
    </div>

    <div class="flex flex-col items-start gap-3 mb-6">
        <img
            src="/prof.svg"
            alt="Dan Ng. avatar"
            width="64"
            height="64"
            class="w-16 h-16 rounded-full object-cover border border-[var(--border)] bg-[var(--bg-b)]"
        />
        <div
            class="flex items-center gap-2 text-[12px] text-[var(--accent)] tracking-[0.04em]"
        >
            <span class="status-dot"></span>
            online · open to work
        </div>
    </div>

    <h1
        class="text-[clamp(2.5rem,6vw,5rem)] font-semibold text-[var(--fg-hi)] leading-[1.05] tracking-[-0.02em] mb-2"
    >
        Dan Ng.
    </h1>
    <p
        class="text-[clamp(1rem,2.5vw,1.4rem)] text-[var(--accent)] mb-8 font-light tracking-[0.01em]"
    >
        Full-stack developer.
    </p>
    <p
        class="text-sm text-[var(--fg)] leading-[1.8] max-w-[540px] mb-10 opacity-85"
    >
        I build fast, modern web applications — from bilingual marketing sites
        to real-time schedulers. Astro, React, and a ThinkPad running Hyprland.
    </p>

    <div class="flex gap-3 flex-wrap">
        <a
            href="#projects"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--accent)] text-white text-xs tracking-[0.08em] font-medium hover:opacity-85 transition-opacity"
        >
            ./projects
            <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                    points="12 5 19 12 12 19"></polyline></svg
            >
        </a>
        <a
            href="/resume"
            class="inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--border)] text-[var(--fg)] text-xs tracking-[0.08em] hover:text-[var(--fg-hi)] hover:border-[var(--fg)] transition-colors"
        >
            <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
            ./resume
        </a>
        <a
            href="https://github.com/Dan925"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--border)] text-[var(--fg)] text-xs tracking-[0.08em] hover:text-[var(--fg-hi)] hover:border-[var(--fg)] transition-colors"
        >
            <svg width="20" height="20" viewBox="0 0 32 32" fill="none"
                ><path
                    d="M15.5 6C9.699 6 5 10.588 5 16.253c0 4.537 3.006 8.369 7.179 9.727.525.09.722-.218.722-.487 0-.243-.013-1.05-.013-1.909C10.25 24.058 9.568 22.956 9.358 22.38c-.118-.295-.63-1.205-1.076-1.449-.369-.192-.894-.666.012-.653.827-.013 1.417.743 1.614 1.05.945 1.551 2.454 1.115 3.058.846.092-.666.368-1.115.67-1.371-2.337-.256-4.778-1.14-4.778-5.062 0-1.115.407-2.038 1.076-2.756-.105-.256-.472-1.307.105-2.717 0 0 .879-.269 2.887 1.051.84-.23 1.732-.345 2.625-.345.893 0 1.785.115 2.625.345 2.008-1.333 2.887-1.051 2.887-1.051.578 1.41.21 2.461.106 2.717.669.718 1.076 1.628 1.076 2.756 0 3.934-2.454 4.806-4.791 5.062.382.32.71.935.71 1.896 0 1.371-.012 2.474-.012 2.82 0 .269.197.589.722.487A10.52 10.52 0 0026 16.253C26 10.588 21.301 6 15.5 6z"
                    fill="currentColor"></path></svg
            >
            github
        </a>
    </div>
</section>
