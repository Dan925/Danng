---
const skills = [
    {
        cat: "Languages",
        items: ["TypeScript", "JavaScript", "Python", "PHP", "Bash", "SQL"],
    },
    {
        cat: "Frontend",
        items: ["React", "Astro", "Next.js", "Tailwind CSS", "HTML/CSS"],
    },
    {
        cat: "Backend",
        items: ["Node.js", "tRPC", "Django", "Prisma", "Postgres"],
    },
    {
        cat: "Tools",
        items: [
            "Git",
            "Linux",
            "Neovim",
            "Tmux",
            "Hyprland",
            "Claude Code",
            "Claude Design",
            "Figma",
            "GitHub Projects",
            "Jira",
        ],
    },
];
---

<section
    id="skills"
    class="py-20 px-4 md:px-8 max-w-[900px] mx-auto border-t border-[var(--border)]"
>
    <div class="text-xs text-[var(--fg)] opacity-50 mb-8">
        <span class="text-[var(--accent)]">dan@portfolio</span><span
            class="opacity-50">:</span
        ><span class="text-[#61afef]">~</span><span class="opacity-50">
            $ cat skills.json</span
        >
    </div>

    <div
        class="grid gap-8"
        style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));"
    >
        {
            skills.map((s) => (
                <div>
                    <div class="text-[13px] text-[var(--accent)] tracking-[0.1em] mb-4 font-medium">
                        // {s.cat}
                    </div>
                    <div class="flex flex-col gap-2.5">
                        {s.items.map((item) => (
                            <div class="flex items-center gap-2.5 text-[15px] text-[var(--fg)]">
                                <span class="text-[var(--border)]">›</span>
                                {item}
                            </div>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</section>
