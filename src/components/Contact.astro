---
const links = [
    {
        label: "ngedan25@gmail.com",
        href: "mailto:ngedan25@gmail.com",
        icon: "mail",
    },
    {
        label: "github.com/Dan925",
        href: "https://github.com/Dan925",
        icon: "github",
    },
    {
        label: "linkedin.com/in/dan-ngendahayo",
        href: "https://www.linkedin.com/in/dan-ngendahayo-6956b1193/",
        icon: "linkedin",
    },
];
---

<section
    id="contact"
    class="py-20 px-4 md:px-8 max-w-[900px] mx-auto border-t border-[var(--border)]"
>
    <div class="text-xs text-[var(--fg)] opacity-50 mb-8">
        <span class="text-[var(--accent)]">dan@portfolio</span><span
            class="opacity-50">:</span
        ><span class="text-[#61afef]">~</span><span class="opacity-50">
            $ contact --open</span
        >
    </div>

    <h2
        class="text-[clamp(1.8rem,4vw,3rem)] font-semibold text-[var(--fg-hi)] mb-3 tracking-[-0.01em]"
    >
        Let's work together.
    </h2>
    <p class="text-sm mb-10 opacity-75 leading-[1.7]">
        Open to new opportunities, collaborations, or just a good conversation.
    </p>

    <div class="flex flex-col gap-4">
        {
            links.map((link) => (
                <a
                    href={link.href}
                    target={link.href.startsWith("http") ? "_blank" : undefined}
                    rel={
                        link.href.startsWith("http") ? "noopener" : undefined
                    }
                    class="contact-link group inline-flex items-center gap-3 text-sm text-[var(--fg)] py-3.5 border-b border-[var(--border)] transition-colors hover:text-[var(--fg-hi)]"
                >
                    <span class="opacity-60 shrink-0">
                        {link.icon === "mail" && (
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 32 32"
                                fill="none"
                            >
                                <path
                                    d="M5.072 9.203A2.876 2.876 0 017.875 7h17.25a2.876 2.876 0 012.803 2.203L16.5 16.087 5.072 9.203zM5 10.821v10.064l8.342-5.041L5 10.82zm9.719 5.855L5.275 22.38A2.876 2.876 0 007.875 24h17.25a2.876 2.876 0 002.599-1.621l-9.444-5.703L16.5 17.747l-1.781-1.07zm4.939-.818L28 20.885V10.821l-8.342 5.037z"
                                    fill="currentColor"
                                />
                            </svg>
                        )}
                        {link.icon === "github" && (
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 32 32"
                                fill="none"
                            >
                                <path
                                    d="M15.5 6C9.699 6 5 10.588 5 16.253c0 4.537 3.006 8.369 7.179 9.727.525.09.722-.218.722-.487 0-.243-.013-1.05-.013-1.909C10.25 24.058 9.568 22.956 9.358 22.38c-.118-.295-.63-1.205-1.076-1.449-.369-.192-.894-.666.012-.653.827-.013 1.417.743 1.614 1.05.945 1.551 2.454 1.115 3.058.846.092-.666.368-1.115.67-1.371-2.337-.256-4.778-1.14-4.778-5.062 0-1.115.407-2.038 1.076-2.756-.105-.256-.472-1.307.105-2.717 0 0 .879-.269 2.887 1.051.84-.23 1.732-.345 2.625-.345.893 0 1.785.115 2.625.345 2.008-1.333 2.887-1.051 2.887-1.051.578 1.41.21 2.461.106 2.717.669.718 1.076 1.628 1.076 2.756 0 3.934-2.454 4.806-4.791 5.062.382.32.71.935.71 1.896 0 1.371-.012 2.474-.012 2.82 0 .269.197.589.722.487A10.52 10.52 0 0026 16.253C26 10.588 21.301 6 15.5 6z"
                                    fill="currentColor"
                                />
                            </svg>
                        )}
                        {link.icon === "linkedin" && (
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 32 32"
                                fill="none"
                            >
                                <path
                                    d="M4 5.719C4 4.77 4.789 4 5.763 4h20.475C27.211 4 28 4.77 28 5.719v20.562C28 27.23 27.211 28 26.238 28H5.763C4.789 28 4 27.23 4 26.281V5.719zm7.415 18.372V13.254H7.813v10.837h3.602zM9.615 11.773c1.255 0 2.037-.831 2.037-1.872-.023-1.063-.782-1.872-2.015-1.872C8.406 8.029 7.6 8.839 7.6 9.901c0 1.041.782 1.872 1.99 1.872h.024zm7.362 12.318v-6.053c0-.324.024-.648.096-.879.26-.647.852-1.317 1.848-1.317 1.304 0 1.824.993 1.824 2.451v5.798H24.37v-6.216c0-3.33-1.776-4.878-4.146-4.878-1.911 0-2.768 1.05-3.248 1.79v.037h-.024l.024-.038v-1.533h-3.6c.045 1.017 0 10.837 0 10.837h3.6z"
                                    fill="currentColor"
                                />
                            </svg>
                        )}
                    </span>
                    <span class="truncate">{link.label}</span>
                    <span class="ml-auto opacity-40 shrink-0">
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </span>
                </a>
            ))
        }
    </div>
</section>

<style>
    .contact-link:hover {
        border-bottom-color: var(--accent);
    }
</style>
