---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Dan Ngendahayo — Resume";
const description =
    "Dan Stéphane Ngendahayo — software engineering graduate from the University of Ottawa (Class of 2024) with 4+ years of full stack development experience.";

const contacts = [
    { label: "ngedan25@gmail.com", href: "mailto:ngedan25@gmail.com" },
    { label: "(873) 355-4805", href: "tel:+18733554805" },
    {
        label: "linkedin.com/in/dan-ngendahayo",
        href: "https://www.linkedin.com/in/dan-ngendahayo-6956b1193/",
    },
    { label: "github.com/Dan925", href: "https://github.com/Dan925" },
];

const skills = [
    {
        cat: "Languages",
        items: ["TypeScript", "JavaScript", "Java", "Python"],
    },
    {
        cat: "Frameworks",
        items: ["React", "Angular", "NodeJS", "Django", "Prisma", "GraphQL"],
    },
    { cat: "Tools", items: ["AWS", "Docker"] },
    {
        cat: "Soft Skills",
        items: [
            "Adaptability",
            "Problem Solving",
            "Critical Thinking",
            "Customer Service",
        ],
    },
];

const languages = [
    { name: "English", level: "Bilingual proficiency" },
    { name: "French", level: "Bilingual proficiency" },
];

const education = [
    {
        degree: "BASc in Software Engineering",
        school: "University of Ottawa",
        time: "09/2019 — 12/2023 (graduated 2024)",
        location: "Ottawa, Ontario",
        notes: ["Dean's list student — CGPA 9.5 / GPA 4.0"],
    },
    {
        degree: "High School Diploma",
        school: "College Catholique Samuel-Genest",
        time: "09/2013 — 06/2019",
        location: "Ottawa, Ontario",
        notes: ["Governor General of Canada medal of excellence"],
    },
];

const certificates = [
    {
        title: "Accessibility for Ontarians with Disabilities (AODA)",
        issuer: "City of Ottawa",
    },
];

const work = [
    {
        role: "Full Stack Developer",
        company: "Signiant Inc.",
        time: "05/2022 — present",
        location: "Ottawa, Ontario",
        bullets: [
           "used various <b>aws cloud services</b> to build scalable back-end services with focus on micro-service architecture in <b>nodejs</b>.",
           "developed custom <b>React</b> components with <b>MaterialUI</b> and used <b>Redux</b> and <b>Redux-saga</b> for state and side effect management.", 
            "improved design thinking skills by actively participating in high level design discussions to provide insightful ideas and expand upon design proposals.",
            "contributed to an agile development process from sprint planning to retrospective by communicating road blocks and collaborating with other developers on a biweekly sprint schedule.",
        ],
    },
    {
        role: "Software Developer",
        company: "Giatec Scientific Inc.",
        time: "09/2021 — 12/2021",
        location: "Ottawa, Ontario",
        bullets: [
            "Worked closely with other developers, the Product Owner and UX to improve product usability by developing new features for their micro-service web app using <b>Django</b> and <b>Angular</b>.",
            "Maintained customer satisfaction by reproducing and resolving bugs in a timely manner.",
            "Participated in Agile development process through <b>SCRUM</b> activities such as sprint planning, stand-ups and retrospectives.",
        ],
    },
    {
        role: "Information Technology Analyst",
        company: "National Research Council of Canada",
        time: "05/2020 — 08/2020 & 01/2021 — 04/2021",
        location: "Ottawa, Ontario",
        bullets: [
            "Improved on front-end development skills with <b>HTML</b>, <b>CSS</b> and <b>JavaScript</b> by creating new web pages to meet specific requirements.",
            "Developed complementary features with a server scripting language in <b>PHP</b> for an IT request management web application.",
            "Implemented new database management reports using <b>ORACLE DB</b> queries and Microsoft <b>PowerShell</b> scripts.",
        ],
    },
];
---

<MainLayout title={title} description={description} hideNav={true}>
    <main
        class="resume max-w-[900px] mx-auto px-4 md:px-8 pt-12 md:pt-16 pb-20"
    >
        <a
            href="/"
            class="resume-back inline-block mb-6 text-xs text-[var(--fg)] opacity-70 hover:opacity-100 hover:text-[var(--fg-hi)] tracking-[0.04em] transition"
        >
            ← cd ..
        </a>
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 mb-6">
            <div class="text-xs text-[var(--fg)] opacity-50 tracking-[0.04em] whitespace-nowrap">
                <span class="text-[var(--accent)]">dan@portfolio</span><span
                    class="opacity-50">:</span
                ><span class="text-[#61afef]">~</span><span class="opacity-50">
                    $ cat resume.md</span
                >
            </div>
            <a
                href="/resume.pdf"
                download
                class="resume-download inline-flex items-center gap-1.5 text-[11px] md:text-sm px-2.5 py-1 md:px-3 md:py-1.5 border border-[var(--border)] text-[var(--fg)] hover:text-[var(--fg-hi)] hover:border-[var(--accent)] transition-colors tracking-[0.04em] whitespace-nowrap"
            >
                ↓ download.pdf
            </a>
        </div>

        <header class="mb-12">
            <h1
                class="text-[clamp(2rem,5vw,3.5rem)] font-semibold text-[var(--fg-hi)] leading-[1.05] tracking-[-0.02em]"
            >
                Dan Stéphane Ngendahayo
            </h1>
            <p class="mt-3 text-[var(--accent)] text-base md:text-lg">
                Full-stack developer
            </p>
            <ul class="contacts mt-5 flex flex-col sm:flex-row sm:flex-wrap sm:gap-x-5 gap-y-1.5 text-[11px] sm:text-xs md:text-sm">
                {
                    contacts.map((c) => (
                        <li class="text-[var(--fg)] flex items-baseline gap-2 min-w-0">
                            <span class="bullet shrink-0">›</span>
                            {c.href ? (
                                <a
                                    href={c.href}
                                    class="hover:text-[var(--fg-hi)] transition-colors truncate"
                                    target={
                                        c.href.startsWith("http")
                                            ? "_blank"
                                            : undefined
                                    }
                                    rel={
                                        c.href.startsWith("http")
                                            ? "noopener"
                                            : undefined
                                    }
                                >
                                    {c.label}
                                </a>
                            ) : (
                                <span class="truncate">{c.label}</span>
                            )}
                        </li>
                    ))
                }
            </ul>
        </header>

        <div class="resume-grid">
            <aside class="flex flex-col gap-10">
                <section>
                    <div class="prompt"># skills</div>
                    <div class="flex flex-col gap-5 mt-3">
                        {
                            skills.map((s) => (
                                <div>
                                    <div class="cat">// {s.cat}</div>
                                    <ul class="flex flex-col gap-1.5 mt-1.5">
                                        {s.items.map((i) => (
                                            <li class="item">
                                                <span class="bullet">›</span>
                                                {i}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))
                        }
                    </div>
                </section>

                <section>
                    <div class="prompt"># languages</div>
                    <ul class="mt-3 flex flex-col gap-2">
                        {
                            languages.map((l) => (
                                <li class="item">
                                    <span class="bullet">›</span>
                                    {l.name}
                                    <span class="opacity-60 text-xs ml-1">
                                        — {l.level}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </section>
            </aside>

            <div class="flex flex-col gap-12">
                <section>
                    <div class="prompt"># work_experience</div>
                    <div class="flex flex-col gap-8 mt-4">
                        {
                            work.map((w) => (
                                <article class="entry">
                                    <h3 class="role">{w.role}</h3>
                                    <div class="company">{w.company}</div>
                                    <div class="meta">
                                        <span>{w.time}</span>
                                        <span>{w.location}</span>
                                    </div>
                                    <ul class="bullets mt-3">
                                        {w.bullets.map((b) => (
                                            <li set:html={b} />
                                        ))}
                                    </ul>
                                </article>
                            ))
                        }
                    </div>
                </section>

                <section>
                    <div class="prompt"># education</div>
                    <div class="flex flex-col gap-6 mt-4">
                        {
                            education.map((e) => (
                                <article class="entry">
                                    <h3 class="role">{e.degree}</h3>
                                    <div class="company">{e.school}</div>
                                    <div class="meta">
                                        <span>{e.time}</span>
                                        <span>{e.location}</span>
                                    </div>
                                    {e.notes && (
                                        <ul class="bullets mt-2">
                                            {e.notes.map((n) => (
                                                <li>{n}</li>
                                            ))}
                                        </ul>
                                    )}
                                </article>
                            ))
                        }
                    </div>
                </section>

                <section>
                    <div class="prompt"># certificates</div>
                    <div class="flex flex-col gap-3 mt-4">
                        {
                            certificates.map((c) => (
                                <article class="entry">
                                    <h3 class="role">{c.title}</h3>
                                    <div class="company">{c.issuer}</div>
                                </article>
                            ))
                        }
                    </div>
                </section>
            </div>
        </div>
    </main>
</MainLayout>

<style>
    .resume {
        font-family: "Fira Code", monospace;
        color: var(--fg);
    }
    .resume-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
    }
    @media (min-width: 768px) {
        .resume-grid {
            grid-template-columns: 220px 1fr;
            gap: 3rem;
        }
    }

    .prompt {
        font-size: 13px;
        color: var(--accent);
        letter-spacing: 0.1em;
        font-weight: 500;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
    }
    .cat {
        font-size: 12px;
        color: var(--fg);
        opacity: 0.7;
        letter-spacing: 0.08em;
    }
    .item {
        display: flex;
        align-items: baseline;
        gap: 8px;
        font-size: 14px;
        color: var(--fg);
    }
    .bullet {
        color: var(--border);
    }

    .entry .role {
        font-size: 16px;
        font-weight: 600;
        color: var(--fg-hi);
    }
    .entry .company {
        font-size: 14px;
        color: var(--accent);
        margin-top: 2px;
    }
    .entry .meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 6px 16px;
        font-size: 12px;
        color: var(--fg);
        opacity: 0.6;
        margin-top: 4px;
    }
    .entry .bullets {
        list-style: none;
        padding-left: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .entry .bullets li {
        position: relative;
        padding-left: 18px;
        font-size: 13px;
        line-height: 1.7;
    }
    .entry .bullets li::before {
        content: "›";
        position: absolute;
        left: 0;
        color: var(--accent);
    }

    @media print {
        :global(.scanline),
        :global(nav),
        :global(footer),
        .resume-download,
        .resume-back {
            display: none !important;
        }
        .resume,
        .resume h1,
        .resume h2,
        .resume h3,
        .resume p,
        .resume li,
        .resume span,
        .resume div,
        .resume .item,
        .resume .cat,
        .resume .entry .role,
        .resume .entry .meta {
            color: #000 !important;
            opacity: 1 !important;
        }
        .resume {
            padding-top: 0 !important;
        }
        .resume .prompt,
        .resume .entry .company,
        .resume .entry .bullets li::before {
            color: #b8442e !important;
        }
        .resume .bullet {
            color: #888 !important;
        }
        :global(html),
        :global(body) {
            background: #fff !important;
            font-size: 11pt !important;
        }
    }
</style>
