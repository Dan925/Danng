---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}
const {
    title = "Dan Ng. — Full-stack developer",
    description = "Dan Stéphane Ngendahayo — full-stack developer. I build fast, modern web applications. Astro, React, and a ThinkPad running Hyprland.",
} = Astro.props as Props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="google-site-verification"
            content="bj7PBB6sjNxkGUjBsSK65sqyVqzW0e-TQiT2sY8C6tA"
        />
        <title>{title}</title>
    </head>
    <body>
        <div class="scanline"></div>
        <NavBar />
        <slot />
        <Footer />
        <script is:inline>
            (function () {
                try {
                    const saved = localStorage.getItem("theme-light");
                    if (saved === "true") {
                        document.documentElement.classList.add("theme-light");
                    }
                } catch (e) {}
            })();
        </script>
    </body>
</html>
